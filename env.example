# =============================================================================
# .env.example — Configuration Reference for AI Job Application Autopilot
#
# INSTRUCTIONS FOR DEVELOPER / DEPLOYMENT:
# 1. Copy this file to `.env`:
#      cp env.example .env
# 2. Fill in your Supabase, Google OAuth, and LLM credentials below.
# 3. All keys are loaded securely through app/config.py using pydantic-settings.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL 16)
# -----------------------------------------------------------------------------
# How to get your Supabase Database URI:
#   1. Go to https://supabase.com/ and create a free project (e.g. "job-autopilot").
#   2. Go to Project Settings > Database > Connection String.
#   3. Select "URI" and choose "Connection pooling" (Session mode or Transaction mode).
#   4. Replace [YOUR-PASSWORD] with your Supabase database password.
#   5. Prefix MUST use: postgresql+asyncpg://
#
# Example Direct Connection:
#   DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Example Supabase Pooler (Recommended for Serverless / Vercel):
#   DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_URL=postgresql+asyncpg://postgres.jntwkfskjpfljymaawwc:YtsB2Z0t3T0nCaak@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
SUPABASE_POOLER_URL=

# -----------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 (End-User Authentication)
# -----------------------------------------------------------------------------
# How to configure for your users:
#   1. Go to Google Cloud Console: https://console.cloud.google.com/
#   2. Create a new project (e.g., "Autopilot App").
#   3. Enable APIs: none required for basic sign-in beyond the consent screen.
#   4. Configure Consent Screen: "APIs & Services" > "OAuth consent screen":
#      - User Type: External
#      - App Name: Autopilot (this is what your end users see when logging in)
#   5. Create Web Client: "APIs & Services" > "Credentials" > "Create Credentials" > "OAuth client ID":
#      - Application Type: Web Application
#      - Authorized JavaScript Origins:
#          http://localhost:5173 (for local React dev)
#          https://your-production-app.vercel.app (for deployed Vercel frontend)
#      - Authorized Redirect URIs:
#          http://localhost:8000/auth/google/callback (for local backend)
#          https://api-your-backend.up.railway.app/auth/google/callback (for production backend)
#   6. Paste the Client ID and Secret below:
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173/

# -----------------------------------------------------------------------------
# 3. LLM PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------
# Provider options: "ollama", "groq", "gemini", "anthropic"
LLM_PROVIDER=ollama

# [Option A: Local Ollama] — Default for local development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=minimax-m3:cloud

# [Option B: Groq API] — Ultra-fast production inference (Free tier available)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# [Option C: Google Gemini API] — High intelligence multimodal models
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# [Option D: Anthropic Claude] — Optional fallback
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# 4. LANGSMITH (Agent Tracing & Evaluation Platform)
# -----------------------------------------------------------------------------
# How to get: https://smith.langchain.com/ -> Settings -> API Keys -> Create Key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_actual_key_here
LANGCHAIN_PROJECT=job-application-autopilot

# -----------------------------------------------------------------------------
# 5. JOB DISCOVERY & SCRAPING (Apify)
# -----------------------------------------------------------------------------
# How to get: https://console.apify.com/ -> Settings -> Integrations -> Personal API Token
# If left empty or test token, the app automatically runs in mock scraping mode for dev testing.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=mojaved~indeed-scraper
APIFY_MAX_RESULTS=5

# -----------------------------------------------------------------------------
# 6. RECRUITER & COMPANY ENRICHMENT (Apollo.io)
# -----------------------------------------------------------------------------
# How to get: https://app.apollo.io/ -> Settings -> Integrations -> API Keys
# If left empty, the app automatically provides mock verified company data.
APOLLO_API_KEY=

# -----------------------------------------------------------------------------
# 7. PDF GENERATION (PDF.co REST API)
# -----------------------------------------------------------------------------
# How to get: https://pdf.co/ -> Sign up -> Dashboard -> API Key
PDFCO_API_KEY=

# -----------------------------------------------------------------------------
# 8. APPLICATION SECURITY SECRETS
# -----------------------------------------------------------------------------
# SESSION_SECRET_KEY: Used to cryptographically sign user session cookies (32+ chars)
# TOKEN_ENCRYPTION_KEY: 32-byte Fernet key used to encrypt OAuth tokens at rest in DB
SESSION_SECRET_KEY=3MP_R6rAgwOze9wECzXTFx8JMcWYI5zNmcw3pxc6cw0
TOKEN_ENCRYPTION_KEY=95fnoEeSufCkEXtzZiynk_O2tWQXgcwYXJD3cHPh74o=

# -----------------------------------------------------------------------------
# 9. GUARDRAILS & SCHEDULER
# -----------------------------------------------------------------------------
MAX_AUTO_SENDS_PER_DAY=10
REVIEW_LOOP_MAX_ATTEMPTS=3
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=24
